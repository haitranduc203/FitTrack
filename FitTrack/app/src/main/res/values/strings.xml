    <!-- Mock Instructions -->
    <string name="instruction_bench_press_1">Lie flat on the bench with feet firmly planted on the floor.</string>
    <string name="instruction_bench_press_2">Grip the barbell slightly wider than shoulder-width apart.</string>
    <string name="instruction_bench_press_3">Unrack the bar and lower it with control toward mid-chest.</string>
    <string name="instruction_bench_press_4">Press the bar back up until your arms are fully extended.</string>

    <string name="instruction_ohp_1">Stand with feet shoulder-width apart holding the barbell at collarbone level.</string>
    <string name="instruction_ohp_2">Brace your core and press the bar directly overhead until arms lock out.</string>
    <string name="instruction_ohp_3">Lower the bar back to collarbone level under control.</string>

    <string name="instruction_squat_1">Position the bar comfortably across your upper back and traps.</string>
    <string name="instruction_squat_2">Descend by bending hips and knees simultaneously while keeping chest up.</string>
    <string name="instruction_squat_3">Lower until thighs are at least parallel to the floor.</string>
    <string name="instruction_squat_4">Drive through your mid-foot to return to the starting upright position.</string>

    <string name="instruction_deadlift_1">Stand with feet hip-width apart and mid-foot directly under the bar.</string>
    <string name="instruction_deadlift_2">Hinge at the hips and grasp the bar just outside your knees.</string>
    <string name="instruction_deadlift_3">Pull chest tall, flatten back, and drive through the floor to stand upright.</string>
    <string name="instruction_deadlift_4">Lower the bar back to the floor along your shins with a controlled hinge.</string>

    <string name="instruction_pullup_1">Grip the overhead pull-up bar with an overhand grip wider than shoulders.</string>
    <string name="instruction_pullup_2">Hang with arms fully extended, engaging your lats and core.</string>
    <string name="instruction_pullup_3">Pull your chest up toward the bar until your chin clears it.</string>
    <string name="instruction_pullup_4">Lower yourself back down smoothly to the full hang position.</string>

